// Generated by NXT-Scratch Visual IDE for LEGO Mindstorms NXT
// Language: NXC (Not eXactly C)

inline void SetMotorPower(byte out, int pwr) {
  if (pwr >= 0) {
    OnFwd(out, pwr);
  } else {
    OnRev(out, -pwr);
  }
}

task main() {
  PlayTone(523, 300);
  Wait(500);
  for (int _count = 0; _count < 3; _count++) {
    SetMotorPower(OUT_A, 75);
    Wait(1000);
    Off(OUT_A);
    Wait(1000);
  }
}
